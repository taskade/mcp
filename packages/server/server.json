{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.taskade/mcp-server",
  "title": "Taskade",
  "description": "Taskade in any AI assistant — projects, tasks, agents, agent chat, automations, webhooks.",
  "websiteUrl": "https://www.taskade.com/mcp",
  "repository": {
    "url": "https://github.com/taskade/mcp.git",
    "source": "github"
  },
  "version": "0.1.1",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.taskade.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@taskade/mcp-server",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your Taskade API key. Get it from Taskade Settings > API.",
          "isRequired": true,
          "isSecret": true,
          "name": "TASKADE_API_KEY"
        }
      ]
    }
  ]
}
